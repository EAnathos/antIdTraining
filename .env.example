# Nom d'utilisateur PostgreSQL utilisé par la configuration Docker locale/dev.
# Remplacez par une valeur adaptée pour les environnements de production.
POSTGRES_USER=postgres

# Mot de passe PostgreSQL utilisé par la configuration Docker locale/dev.
# Remplacez par une valeur robuste en production.
POSTGRES_PASSWORD=postgres

# Nom de la base de données PostgreSQL créée/utilisée en développement.
# En production, l'application lit `DATABASE_URL` (voir apps/backend/.env.example).
POSTGRES_DB=antidtraining
