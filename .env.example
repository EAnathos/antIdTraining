# =============================================================================
# BASE DE DONNÉES (PostgreSQL)
# =============================================================================

# Nom d'hôte du service PostgreSQL (nom du container Docker).
POSTGRES_HOST=postgres

# Port interne PostgreSQL.
POSTGRES_PORT=5432

# Identifiants PostgreSQL.
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=replace-me

# =============================================================================
# REDIS
# =============================================================================

# Nom d'hôte du service Redis (nom du container Docker).
REDIS_HOST=redis

# Port interne Redis.
REDIS_PORT=6379

# Mot de passe Redis.
REDIS_PASSWORD=replace-me

# =============================================================================
# PORTS EXPOSÉS (hôte → container)
# =============================================================================

# Port exposé par Nginx vers l'hôte.
NGINX_PORT=80

# Port exposé par Prometheus vers l'hôte (lié à 127.0.0.1 — accès SSH tunnel).
PROMETHEUS_PORT=9090

# =============================================================================
# GRAFANA
# =============================================================================

# Credentials de l'interface Grafana (accessible via /grafana/).
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-me
