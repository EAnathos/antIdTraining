# Fichier d'exemple pour les variables liées à Docker/local uniquement.
# Ne mettez jamais de vraies valeurs secrètes ici.

# Noms des services Docker (ne pas modifier sauf si vous renommez les services)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=replace-me

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-me

BACKEND_PORT=4000
FRONTEND_PORT=3000
