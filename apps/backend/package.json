{
  "name": "backend",
  "version": "1.0.0",
  "description": "API backend d'Ant ID Training avec Express, Prisma et PostgreSQL.",
  "main": "index.js",
  "scripts": {
    "pretest": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "prisma generate",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "user:create": "tsx scripts/create-user.ts",
    "user:delete": "tsx scripts/delete-user.ts",
    "user:list": "tsx scripts/list-users.ts"
  },
  "keywords": [
    "api",
    "express",
    "prisma",
    "postgresql",
    "backend"
  ],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
