# =============================================================================
# ENVIRONNEMENT
# =============================================================================

# "development" ou "production".
# En production, les endpoints de développement (Swagger UI, /api/openapi.json)
# sont désactivés.
NODE_ENV="development"

# =============================================================================
# BASE DE DONNÉES
# =============================================================================

# Connexion PostgreSQL utilisée par Prisma.
# Exemple : postgresql://user:password@host:5432/dbname?schema=public
DATABASE_URL="replace-me"

# =============================================================================
# AUTHENTIFICATION
# =============================================================================

# Secret de signature des JWT. Générer une valeur longue et aléatoire (32+ bytes).
JWT_SECRET="replace-me"

# Secret de chiffrement AES-256-GCM pour les champs PII (photoCredit, email suggestion…).
# Obligatoire en production.
DATA_ENCRYPTION_KEY="replace-me"

# =============================================================================
# SERVEUR
# =============================================================================

# Port HTTP d'écoute du backend.
PORT=4000

# Niveau de confiance proxy Express.
# Mettre à "1" si un seul proxy (nginx) est devant le backend.
# Défaut : "loopback, uniquelocal" (fonctionne en Docker sans modification).
# TRUST_PROXY=1

# Origines autorisées pour CORS (séparées par virgule).
# Exemple : CORS_ORIGINS="https://app.example.com,https://admin.example.com"
CORS_ORIGINS="replace-me"

# =============================================================================
# REDIS
# =============================================================================

# URL de connexion Redis (cache / rate-limiting).
# En Docker  : redis://:password@redis:6379
# En dev local : redis://localhost:6379
REDIS_URL="redis://:replace-me@redis:6379"

# =============================================================================
# EMAIL
# =============================================================================

# Clé API Resend pour l'envoi des emails transactionnels.
RESEND_API_KEY="replace-me"

# Adresse expéditrice des emails.
RESEND_FROM="Ant ID Training <no-reply@example.com>"

# URL publique du frontend, utilisée pour construire les liens de reset de mot de passe.
FRONTEND_URL="http://localhost:5173"

# Désactiver les emails de notification de connexion. Mettre à "false" en dev.
SEND_LOGIN_NOTIFICATION_EMAILS=true

# =============================================================================
# LOGS
# =============================================================================

# Niveau de log (debug, info, warn, error).
LOG_LEVEL="info"
