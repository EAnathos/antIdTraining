# PostgreSQL connection string used by Prisma. Replace with your production DB URL.
# Example: postgresql://user:pass@host:5432/dbname?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/antidtraining?schema=public"

# Secret utilisé pour signer les JWT d'authentification.
# En production, définissez une valeur forte et unique (ex: 32+ random bytes).
JWT_SECRET="change-this-secret"

# Port HTTP sur lequel le backend écoute (par défaut pour le développement).
PORT=4000

# Clé de chiffrement applicative pour les données sensibles stockées en base
# (ex: crédits photo, noms/emails de suggestions). Valeur attendue : une
# chaîne secrète suffisamment longue et aléatoire. En production, remplacez
# la valeur par une clé robuste et protégez-la via votre gestionnaire d'env.
# Si vous perdez la clé, les données chiffrées existantes deviendront illisibles.
DATA_ENCRYPTION_KEY="change-this-encryption-secret"

# Niveau de log pour le backend (ex: debug, info, warn, error). En dev
# `debug` active plus de détails; en prod `info` ou `warn` est recommandé.
LOG_LEVEL="info"

# URL du serveur Redis utilisé pour le cache / rate-limiting.
# Par défaut on propose `redis://localhost:6379` pour les environnements locaux.
# En production, définissez explicitement l'URL (hôte, port et éventuellement
# mot de passe). Si vous n'utilisez pas Redis, laissez vide et désactivez
# les fonctionnalités dépendantes (ou installez Redis sur la machine).
REDIS_URL="redis://localhost:6379"
