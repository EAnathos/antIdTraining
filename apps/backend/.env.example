# PostgreSQL connection string used by Prisma.
# Example:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DATABASE_URL="replace-me"

# Secret used to sign authentication JWTs.
# Generate a long, random value and store it in your secret manager.
JWT_SECRET="replace-me"

# HTTP port for the backend.
PORT=4000

# Secret used to encrypt sensitive data stored in the database.
# Required in production.
DATA_ENCRYPTION_KEY="replace-me"

# Logging level.
LOG_LEVEL="info"

# Allowed frontend origins for CORS.
# Example: CORS_ORIGINS="https://app.example.com,https://admin.example.com"
CORS_ORIGINS="replace-me"

# Redis URL for cache / rate limiting.
REDIS_URL="redis://localhost:6379"
