generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum ReferenceType {
  WEBSITE
  MYRMECOLOGY
}

enum TaxonLevel {
  SUBFAMILY
  GENUS
  SPECIES
}

enum GameDifficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Taxon {
  id           String   @id @default(cuid())
  subfamily    String
  tribe        String?
  genus        String
  subgenus     String?
  speciesGroup String?
  species      String
  swarmingStartMonth Int?
  swarmingEndMonth   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries ObservationEntry[]
  references Reference[]

  @@index([subfamily])
  @@index([genus])
  @@index([species])
  @@unique([subfamily, tribe, genus, species])
}

model TaxonLevelProfile {
  id        String   @id @default(cuid())
  level     TaxonLevel
  value     String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  criteria TaxonLevelCriterion[]

  @@unique([level, value])
  @@index([level])
  @@index([value])
}

model TaxonLevelCriterion {
  id        String   @id @default(cuid())
  profileId String
  label     String
  position  Int
  createdAt DateTime @default(now())

  profile TaxonLevelProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, position])
}

model ObservationEntry {
  id           String   @id @default(cuid())
  taxonId      String?
  taxonLevel   TaxonLevel
  taxonValue   String
  subfamily    String
  genus        String?
  species      String?
  speciesGroup String?
  size         String?
  department   String
  observedAt   DateTime
  biotope      String
  photoCredit  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  taxon Taxon? @relation(fields: [taxonId], references: [id], onDelete: SetNull)
  images EntryImage[]
  gameSessions GameSession[]

  @@index([taxonLevel])
  @@index([taxonValue])
  @@index([subfamily])
  @@index([genus])
  @@index([species])
  @@index([department])
  @@index([observedAt])
}

model GameSession {
  id            String         @id @default(cuid())
  level         GameDifficulty
  entryId       String?
  finalCorrect  Boolean?
  validatedAt   DateTime?
  createdAt     DateTime       @default(now())

  entry ObservationEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@index([level])
  @@index([createdAt])
  @@index([finalCorrect])
}

model EntryImage {
  id        String   @id @default(cuid())
  entryId   String
  imageUrl  String
  createdAt DateTime @default(now())

  entry ObservationEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

model Reference {
  id          String        @id @default(cuid())
  title       String
  authors     String[]      @default([])
  description String?
  type        ReferenceType
  url         String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  taxons      Taxon[]
}
