generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum ReferenceType {
  WEBSITE
  MYRMECOLOGY
}

enum SuggestionStatus {
  PENDING
  PROCESSED
  REJECTED
}

enum AdminHistoryTone {
  SUCCESS
  ERROR
  INFO
}

enum TaxonLevel {
  SUBFAMILY
  GENUS
  SPECIES
}

enum Caste {
  WORKER
  QUEEN
  MALE
}

enum GameDifficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  adminHistoryEvents AdminHistoryEvent[]
  gameSessions       GameSession[]
}

model AdminHistoryEvent {
  id             String           @id @default(cuid())
  createdAt      DateTime         @default(now())
  action         String
  detail         String
  tone           AdminHistoryTone @default(INFO)
  actorUserId    String?
  actorUsername  String?
  entityType     String?
  entityId       String?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([entityType, entityId])
}

model Taxon {
  id           String   @id @default(cuid())
  subfamily    String
  tribe        String?
  genus        String
  subgenus     String?
  speciesGroup String?
  species      String
  swarmingStartMonth Int?
  swarmingEndMonth   Int?
  distribution Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries ObservationEntry[]
  references Reference[]

  @@index([subfamily])
  @@index([genus])
  @@index([species])
  @@unique([subfamily, tribe, genus, species])
}

model TaxonLevelProfile {
  id        String   @id @default(cuid())
  level     TaxonLevel
  value     String
  description String?
  sizeWorker String?
  sizeQueen  String?
  sizeMale   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  criteria TaxonLevelCriterion[]

  @@unique([level, value])
  @@index([level])
  @@index([value])
}

model TaxonLevelCriterion {
  id        String   @id @default(cuid())
  profileId String
  label     String
  position  Int
  createdAt DateTime @default(now())

  profile TaxonLevelProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, position])
}

model ObservationEntry {
  id           String   @id @default(cuid())
  taxonId      String?
  taxonLevel   TaxonLevel
  taxonValue   String
  subfamily    String
  genus        String?
  subgenus     String?
  species      String?
  speciesGroup String?
  size         String?
  caste        Caste
  department   String
  observedAt   DateTime
  biotope      String
  photoCredit  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  taxon Taxon? @relation(fields: [taxonId], references: [id], onDelete: SetNull)
  images EntryImage[]
  gameSessions GameSession[]

  @@index([taxonLevel])
  @@index([taxonValue])
  @@index([subfamily])
  @@index([genus])
  @@index([species])
  @@index([department])
  @@index([observedAt])
}

model GameSession {
  id            String         @id @default(cuid())
  level         GameDifficulty
  entryId       String?
  userId        String?
  finalCorrect  Boolean?
  validatedAt   DateTime?
  createdAt     DateTime       @default(now())

  entry ObservationEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  user  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([level])
  @@index([createdAt])
  @@index([finalCorrect])
  @@index([userId])
}

model EntryImage {
  id        String   @id @default(cuid())
  entryId   String
  imageUrl  String
  position  Int?
  createdAt DateTime @default(now())

  entry ObservationEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

model Reference {
  id          String        @id @default(cuid())
  title       String
  authors     String[]      @default([])
  description String?
  type        ReferenceType
  url         String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  taxons      Taxon[]
}

model Suggestion {
  id         String           @id @default(cuid())
  name       String?
  email      String?
  message    String
  status     SuggestionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  processedAt DateTime?
}
