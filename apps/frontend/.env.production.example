# =============================================================================
# FRONTEND — Variables de build Vite (production)
# =============================================================================
# Copier en .env.production et renseigner les valeurs avant de builder.
# Ces variables sont injectées au moment du build (pas à l'exécution).
# Toutes les variables exposées au client doivent avoir le préfixe VITE_.

# =============================================================================
# API
# =============================================================================

# Chemin de base de l'API appelée par le frontend.
# En production derrière Nginx (même origine) : /api
VITE_API_URL=/api

# Origine du backend, utilisée pour les requêtes cross-origin si le frontend
# et le backend sont sur des domaines différents.
# Laisser vide si Nginx sert les deux sur la même origine.
VITE_BACKEND_ORIGIN=
