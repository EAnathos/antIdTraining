# Variables de build Vite pour la production.
# Copier en .env.production et renseigner les valeurs avant de builder.
# Ces variables sont injectées au moment du build (pas à l'exécution).

# URL de base de l'API appelée par le frontend.
# En production derrière nginx : /api (même origine, pas de CORS).
VITE_API_URL=/api

# Origine du backend, utilisée pour les requêtes cross-origin si le
# frontend et le backend sont sur des domaines différents.
# Laisser vide si nginx sert les deux sur la même origine.
VITE_BACKEND_ORIGIN=
